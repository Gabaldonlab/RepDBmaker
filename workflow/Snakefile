configfile: "config/repdb.yaml"


# Test mode: subsample TEST_N genomes per source (gtdb, virus, uniprot, eukprot,
# p10k, custom) so the whole pipeline can be run end-to-end quickly.
#   test: false  -> off (default)   test: true -> 10 per source   test: <int> -> N
_test = config.get("test", False)
if _test in (False, None, 0):
    TEST_N = 0
elif _test is True:
    TEST_N = 10
else:
    TEST_N = int(_test)

if TEST_N:
    logger.warning(
        "=" * 72
        + f"\n⚠  TEST MODE ACTIVE: keeping only {TEST_N} genomes per source.\n"
        + "   The resulting RepDB is a small end-to-end smoke test, NOT a full\n"
        + "   database. Set `test: false` (or remove it) in the config for a real run.\n"
        + "=" * 72
    )


valid_db_types = {"diamond", "blastp", "mmseqs"}
if "dbs" in config and "type" in config["dbs"]:
    invalid = set(config["dbs"]["type"]) - valid_db_types
    if invalid:
        raise ValueError(
            f"Invalid dbs.type values: {sorted(invalid)}. "
            f"Allowed: {sorted(valid_db_types)}."
        )


