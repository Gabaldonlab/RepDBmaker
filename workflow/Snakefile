configfile: "config/repdb.yaml"


# Test mode: subsample TEST_N genomes per source (gtdb, virus, uniprot, eukprot,
# p10k, custom) so the whole pipeline can be run end-to-end quickly.
#   test: false  -> off (default)   test: true -> 10 per source   test: <int> -> N
_test = config.get("test", False)
if _test in (False, None, 0):
    TEST_N = 0
elif _test is True:
    TEST_N = 10
else:
    TEST_N = int(_test)

if TEST_N:
    logger.warning(
        "=" * 72
        + f"\n⚠  TEST MODE ACTIVE: keeping only {TEST_N} genomes per source.\n"
        + "   The resulting RepDB is a small end-to-end smoke test, NOT a full\n"
        + "   database. Set `test: false` (or remove it) in the config for a real run.\n"
        + "=" * 72
    )


valid_db_types = {"diamond", "blastp", "mmseqs"}
if "dbs" in config and "type" in config["dbs"]:
    invalid = set(config["dbs"]["type"]) - valid_db_types
    if invalid:
        raise ValueError(
            f"Invalid dbs.type values: {sorted(invalid)}. "
            f"Allowed: {sorted(valid_db_types)}."
        )


# Import modules/rules
include: "rules/download.smk"
include: "rules/gtdb.smk"
include: "rules/taxonomy.smk"
include: "rules/common.smk"
include: "rules/db.smk"
include: "rules/cluster.smk"
include: "rules/stats.smk"
include: "rules/decontaminate.smk"
include: "rules/universe.smk"


# Test mode subsamples the fetched sequences, so it cannot coexist with
# reproduce mode (a pinned universe, which must reproduce the exact composition).
if TEST_N and REPDB_UNIVERSE:
    raise ValueError(
        "Test mode (`test`) and pinned-universe mode (`dbs.build.repdb.universe`) "
        "are mutually exclusive: test mode would subsample the frozen universe "
        "instead of reproducing it. Disable one of them."
    )


onstart:
    print("\n--- Workflow started ---\n")


onsuccess:
    print("\n--- Workflow finished! ---\n")


onerror:
    print("\n--- An error occurred! ---\n")


