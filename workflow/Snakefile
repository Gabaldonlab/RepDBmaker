def get_database_targets():
    """Generate database targets based on config."""
    targets = []
    dbs_config = config.get("dbs", {}).get("build", {})

    # repdb
    if "repdb" in dbs_config.keys():
        targets.append("repdb")

    # custom databases: allow either string path or dict with options
    custom_dbs = dbs_config.get("custom", {})
    if isinstance(custom_dbs, dict):
        targets.extend(custom_dbs.keys())

    return targets


def get_clustered_database_targets():
    """Return databases that need cluster-specific .fa input"""
    return [db for db in get_database_targets() if _is_db_clustered(db)]


def get_decontaminated_database_targets():
    """Return databases that need decontamination outputs"""
    return [db for db in get_database_targets() if _is_db_decon(db)]


rule all:
    input:
        # Downloadable files
        "results/meta/check_resources.txt",
        # QC: taxonomy harmonization report + interactive Krona charts (normal
        # mode only; the per-source taxonomies are not built from a frozen manifest)
        *(["results/qc/harmonization_report.html",
           "results/qc/krona/repdb_krona.html"] if not REPDB_MANIFEST else []),
        # Database files
        expand(
            "results/dbs/{db}/{db}_{dbtype}",
            db=get_database_targets(),
            dbtype=config["dbs"]["type"],
        ),
        # Clustering files
        expand(
            "results/dbs/{db}/cluster/cluster_params.yaml",
            db=get_clustered_database_targets(),
        ),
        # Decontamination files
        expand(
            "results/dbs/{db}/decontaminate/decontaminate_params.yaml",
            db=get_decontaminated_database_targets(),
        ),
        expand(
            "results/dbs/{db}/decontaminate/contaminants.tsv",
            db=get_decontaminated_database_targets(),
        ),
        expand(
            "results/dbs/{db}/decontaminate/pair_counts.tsv",
            db=get_decontaminated_database_targets(),
        ),
        # Stats files
        expand("results/stats/{db}_stats.tsv", db=get_database_targets()),
        expand(
            "results/stats/{db}_clustered_stats.tsv",
            db=get_clustered_database_targets(),
        ),
        # get_optional_targets()
